# Copy to .env and fill in. Never commit .env (it is gitignored).

# --- App ---
NODE_ENV=development
# Public URL of the staff app. Mutating API requests must come from this origin.
# Dev: the Vite dev server. Production: the HTTPS URL, for example https://scan.bedrijfsnaam.nl
APP_ORIGIN=http://localhost:5173
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Behind Caddy, Nginx or Traefik: true (or a number of hops), so client IPs and HTTPS are read from the proxy headers.
TRUST_PROXY=false
# true in production (HTTPS only cookies).
COOKIE_SECURE=false
SESSION_TTL_DAYS=14
# Optional. Comma-separated CIDRs that may reach the staff app, for example 192.168.1.0/24,10.8.0.0/24 (office, VPN).
# Customer share pages and /health stay reachable from anywhere. Empty = no restriction.
STAFF_ALLOWED_CIDRS=
# Files volume (scans, renders, photos). Relative paths are resolved from the repo root in dev.
DATA_DIR=./data

# --- Database ---
DATABASE_URL=postgres://scan:scan@localhost:5432/scan
# Used by the test suite; it is wiped on every run.
DATABASE_URL_TEST=postgres://scan:scan@localhost:5432/scan_test

# --- First admin: created at startup when no admin exists yet. Change the password after the first login. ---
ADMIN_EMAIL=admin@example.nl
ADMIN_NAME=Beheerder
# At least 12 characters.
ADMIN_PASSWORD=

# --- Odoo (used from M3). Point it at the LOCAL Odoo; never at production without asking first. ---
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_API_KEY=
# Every Odoo write only logs what it would do while this is true.
ODOO_DRY_RUN=true
ODOO_VIDEO_FIELD=x_roof_video_url

# --- Local Odoo in Docker (compose.dev.yml, profile "odoo") ---
# Same major version as production. Odoo Online shows it under Instellingen, at the bottom.
ODOO_VERSION=19.0

# --- Production compose (compose.yml) ---
# Domain Caddy requests a certificate for (only with the "caddy" profile).
DOMAIN=scan.example.nl
POSTGRES_PASSWORD=
