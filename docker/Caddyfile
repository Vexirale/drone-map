# HTTPS in front of the API (compose profile "caddy"). Caddy gets the certificate for DOMAIN itself.
# Behind Caddy, set TRUST_PROXY=1 and COOKIE_SECURE=true in .env, and APP_ORIGIN=https://<DOMAIN>.
{$DOMAIN} {
	encode zstd gzip
	# Scan uploads arrive in chunks of at most 64 MB (SPEC: Phase 1, 3D input). On Google Cloud they
	# go straight to the bucket and never pass through here.
	request_body {
		max_size 100MB
	}
	reverse_proxy api:3000
}
