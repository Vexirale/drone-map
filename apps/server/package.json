{
  "name": "@scan/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts api",
    "dev:worker": "node --watch --env-file-if-exists=../../.env src/main.ts worker",
    "start": "node src/main.ts api",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/cli/migrate.ts",
    "user:add": "node --env-file-if-exists=../../.env src/cli/user-add.ts",
    "user:reset-totp": "node --env-file-if-exists=../../.env src/cli/user-reset-totp.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.5",
    "@node-rs/argon2": "2.2.2",
    "@scan/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "pg-boss": "12.37.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
